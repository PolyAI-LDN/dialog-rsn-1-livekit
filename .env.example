# A Dialog-RSN-1 API key: sign up or log in at https://studio.poly.ai and create one in the API Keys tab
DIALOG_API_KEY=

# An ElevenLabs API key (the free tier works)
ELEVEN_API_KEY=

# Your LiveKit server. Only needed for `uv run agent.py dev`, not for `lk agent console`.
# These are the defaults for a local `livekit-server --dev`; use your LiveKit Cloud project's values instead.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Optional
# DIALOG_REALTIME_URL=wss://api.studio.poly.ai/v1/realtime
